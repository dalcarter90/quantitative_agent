# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Every value here is a placeholder or a safe default.

# --- Trading mode -----------------------------------------------------------
# "paper" is the default everywhere. Live trading needs BOTH lines below set,
# plus the --live flag on the command line (see CLAUDE.md, "Safety rules").
QA_TRADING_MODE=paper
QA_LIVE_TRADING_ACK=

# --- Crypto market data / execution ----------------------------------------
# Public market data needs no keys. Keys are only for account/execution use.
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- US equities (Alpaca) ---------------------------------------------------
# Paper endpoint by default. The live endpoint is only used in live mode.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Agent layer ------------------------------------------------------------
# Used only by the agent process. Exchange keys above are never loaded into
# the agent process (see docs/adr/0007-agent-tool-permissions.md).
ANTHROPIC_API_KEY=

# --- Local paths ------------------------------------------------------------
QA_DATA_DIR=./data
QA_JOURNAL_DIR=./journals
